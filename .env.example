# 1 = offline mock judge (reference-token recall), no keys needed. 0 = Claude judge.
MOCK_MODE=1
# Required only when MOCK_MODE=0.
ANTHROPIC_API_KEY=
# Judge model and its USD-per-million-token prices (used for the cost column).
JUDGE_MODEL=claude-sonnet-5-5
JUDGE_PRICE_IN=2.0
JUDGE_PRICE_OUT=10.0
# Postgres DSN for the API and worker. docker compose sets this for you.
DATABASE_URL=
# CLI: record runs on this server instead of scoring locally.
EAAS_SERVER=
# Host ports under docker compose.
API_PORT=8102
DB_PORT=5434
